
<%- include('../partials/head') %>
</head>

<body>
  <%- include('../partials/nav') %>

  <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-7xl">

    <h2 class="text-3xl text-red-500 font-bold text-center mb-8">
      Curated Stays
    </h2>

    <% if (favouriteHomes && favouriteHomes.length > 0) { %>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

        <% favouriteHomes.forEach(home => { %>

          <li class="bg-white rounded-lg shadow-md overflow-hidden flex flex-col h-full">

            <!-- IMAGE -->
            <div class="overflow-hidden rounded-t-lg">
              <img
                src="<%= home.photoUrl %>"
                alt="<%= home.houseName %>"
                class="w-full h-44 object-cover transition-transform duration-500 hover:scale-110"
              >
            </div>

            <!-- CONTENT -->
            <div class="p-4 flex-grow flex flex-col justify-between">

              <div>
                <h2 class="text-lg font-semibold text-gray-800">
                  <%= home.houseName %>
                </h2>

                <p class="text-sm text-gray-500 mt-1">
                  <%= home.location %>
                </p>

                <div class="flex justify-between items-center mt-5">
                  <span class="text-red-500 font-semibold">
                    ₹ <%= home.price %> / night
                  </span>

                  <span class="text-yellow-400 text-sm">
                    ⭐ <%= home.rating %>
                  </span>
                </div>
              </div>

              <!-- REMOVE BUTTON -->
              <form action="/favourites/delete/<%= home.id %>" method="POST" class="mt-4">
                <button
                  type="submit"
                  class="w-full bg-rose-500 text-white py-2 rounded-md hover:bg-rose-600 transition-all text-sm font-semibold"
                >
                  Remove from Favourites
                </button>
              </form>

            </div>

          </li>

        <% }) %>

      </ul>

    <% } else { %>

      <div class="text-center py-12">
        <h3 class="text-xl text-gray-600 font-semibold">
          No favourite homes found!
        </h3>

        <p class="text-gray-400 mt-2">
          Add homes to your favourites to see them here.
        </p>
      </div>

    <% } %>

  </main>

</body>
</html>

















