<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-xl">
      <h2 class="text-3xl text-red-500 font-bold text-center mb-10">
        Your Perfect Escape Starts Here:
      </h2>



<!-- Main Container -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 bg-white p-4 rounded-2xl shadow-lg max-w-4xl mx-auto border border-gray-100">

    <!-- LEFT SIDE -->
    <div class="flex flex-col items-center">

        <!-- IMAGE -->
      

<div class="relative w-full max-w-md mx-auto overflow-hidden rounded-3xl shadow-2xl group">
    
    <img src="<%= home.photoUrl %>" 
         alt="Property Image" 
         class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105">

    <div class="absolute top-4 right-4 z-20">
        <%- include('../partials/favourite', {home: home}) %>
    </div>

</div>
        
        


        <!-- HOUSE NAME -->
       
<div class="flex justify-between items-center mt-3">
    

    <h2 class="text-2xl font-bold text-gray-800">
        <%= home.houseName %>
    </h2>
<!--<%- include('../partials/favourite') %>-->
  

</div>


        <p class="text-pink-500 text-xs font-medium mt-1">
            Premium Luxury Stay ✨
        </p>

        <!-- BUTTON -->
        <button 
            class="mt-3 bg-gradient-to-r from-rose-500 to-pink-500 
            hover:from-rose-600 hover:to-pink-600
            text-white text-sm font-semibold py-2 px-8 rounded-xl 
            shadow-md transition duration-300 hover:scale-105">
            Book Now
        </button>
    
  



 

    </div>

    <!-- RIGHT SIDE -->
    <div class="flex flex-col space-y-3 pt-1">

        <!-- DESCRIPTION -->
        <div class="bg-gray-50 p-3 rounded-xl">
            <h3 class="text-base font-bold text-gray-800 mb-1">
                Description
            </h3>

            <p class="text-gray-600 text-xs leading-relaxed">
                <%= home.description || "Beautiful and comfortable home for your perfect vacation stay." %>
            </p>
        </div>

        <!-- LOCATION -->
        <div class="flex items-center gap-2 p-2 rounded-xl border border-gray-100 shadow-sm">
            <span>📍</span>

            <div>
                <p class="text-[11px] text-gray-400 font-medium">
                    Location
                </p>

                <p class="text-sm font-semibold text-gray-700">
                    <%= home.location %>
                </p>
            </div>
        </div>

        <!-- PRICE -->
        <div class="flex items-center gap-2 p-2 rounded-xl border border-gray-100 shadow-sm">
            <span>💰</span>

            <div>
                <p class="text-[11px] text-gray-400 font-medium">
                    Price
                </p>

                <p class="text-base font-bold text-green-600">
                    ₹ <%= home.price %> / night
                </p>
            </div>
        </div>

        <!-- RATING -->
        <div class="flex items-center gap-2 p-2 rounded-xl border border-gray-100 shadow-sm">
            <span>⭐</span>

            <div>
                <p class="text-[11px] text-gray-400 font-medium">
                    Rating
                </p>

                <p class="text-sm font-semibold text-yellow-500">
                    <%= home.rating || "4.5" %> / 5
                </p>
            </div>
        </div>

    </div>

</div>



</main>
  </body>
  </html>
